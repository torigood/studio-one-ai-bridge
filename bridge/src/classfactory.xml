<?xml version="1.0" encoding="UTF-8"?>
<ClassFactory>
	<Version name="AI Bridge" version="0.3.4" vendor="local"/>

	<!-- Loaded at startup (same category as the Macro Manager service).
	     Writes status.json and host-api.json; cannot edit the song (no edit context). -->
	<ScriptClass
		classID="{A23B5E56-BF9B-4F88-8F5F-5491DFC1B7E6}"
		category="FrameworkService"
		name="AI Bridge Service"
		sourceFile="service.js"
		functionName="createBridgeService">
	</ScriptClass>

	<!-- Runs every job waiting in the inbox with a full edit context.
	     Run it once by hand (Keyboard Shortcuts); it then starts the idle-task poller.
	     NOTE: adding commandCategory/alwaysEnabled attributes here, together with an idle
	     task registered at startup, crashed Studio One at launch (0.2.0/0.2.1, 2026-10-17). -->
	<ScriptClass
		classID="{2A331F47-5881-4E68-A3F6-AFFA29DBD8D7}"
		category="EditTask"
		subCategory="TrackEdit"
		name="AI Bridge - Run Jobs"
		sourceFile="tasks.js"
		functionName="createRunJobsTask">
		<Attribute id="menuPriority" value="100"/>
	</ScriptClass>

	<!-- Writes a recursive dump of the Host object to host-api.json (discovery). -->
	<ScriptClass
		classID="{FD340BE6-B3F2-4D4D-9B97-618218876435}"
		category="EditTask"
		subCategory="TrackEdit"
		name="AI Bridge - Dump Host API"
		sourceFile="tasks.js"
		functionName="createDumpTask">
		<Attribute id="menuPriority" value="101"/>
	</ScriptClass>
</ClassFactory>
